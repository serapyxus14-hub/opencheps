
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FF0D1F12">

    <LinearLayout
        android:orientation="vertical"
        android:padding="22dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="♟ OpenCheps"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="POST-GAME STOCKFISH ANALYZER"
            android:textColor="#FFA5D6A7"
            android:textSize="12sp"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="18dp"
            android:background="#5539C96B"/>

        <TextView
            android:id="@+id/status"
            android:text="Starting Stockfish..."
            android:textColor="#FFA5D6A7"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnImport"
            android:text="IMPORT COMPLETED GAME (.PGN)"
            android:textColor="#FF0D1F12"
            android:textStyle="bold"
            android:backgroundTint="#FF00C853"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="GAME"
            android:textColor="#FFFFEB3B"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/gameInfo"
            android:text="No game imported yet."
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#5539C96B"/>

        <TextView
            android:text="POSITION REVIEW"
            android:textColor="#FFFFEB3B"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/positionInfo"
            android:text="No position selected"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnPrevious"
                android:text="← Previous"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnNext"
                android:text="Next →"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/fenInfo"
            android:text=""
            android:textColor="#FFB0BEC5"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:background="#FF182B20"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnAnalyze"
            android:text="ANALYZE THIS POSITION"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF1B5E20"
            android:enabled="false"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="STOCKFISH RESULTS"
            android:textColor="#FFFFEB3B"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/analysisInfo"
            android:text="Import a completed game to begin."
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="#FF182B20"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="OpenCheps · Offline game review"
            android:textColor="#FF789080"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="28dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
